{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreebuffProxy",
  "version": "1.14.7",
  "identifier": "com.freebuff.proxy.desktop",
  "build": {
    "beforeBuildCommand": "npm run prepare-runtime",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Freebuff Proxy 控制台",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --proxy-server=direct://"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/128x128.png"],
    "resources": ["resources/server"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
